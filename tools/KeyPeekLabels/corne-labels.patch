diff --git a/src/label_profile.rs b/src/label_profile.rs
new file mode 100644
index 0000000..5a292da
--- /dev/null
+++ b/src/label_profile.rs
@@ -0,0 +1,285 @@
+use crate::key_action::{KeyAction, LayerInfo};
+use crate::layout_key::{BorderStyle, KeycodeKind, Label, LayoutKey};
+use crate::protocols::KeyboardDefinition;
+use directories::ProjectDirs;
+use serde::Deserialize;
+use std::collections::BTreeMap;
+use std::io::ErrorKind;
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct LabelProfile {
+    vid: u16,
+    pid: u16,
+    vial_uid: [u8; 8],
+    rows: usize,
+    cols: usize,
+    layers: Vec<String>,
+    #[serde(default)]
+    keycodes: BTreeMap<u16, DisplayLabel>,
+    #[serde(default)]
+    positions: Vec<PositionLabel>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DisplayLabel {
+    text: String,
+    short: Option<String>,
+    target_layer: Option<u8>,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PositionLabel {
+    row: usize,
+    col: usize,
+    layer: Option<usize>,
+    label: DisplayLabel,
+}
+
+impl DisplayLabel {
+    fn validate(&self, layer_count: usize) -> bool {
+        !self.text.trim().is_empty()
+            && self
+                .target_layer
+                .is_none_or(|layer| (layer as usize) < layer_count)
+    }
+
+    fn layout_key(&self) -> LayoutKey {
+        LayoutKey {
+            tap: Label {
+                full: self.text.clone(),
+                short: self.short.clone(),
+            },
+            kind: KeycodeKind::Special,
+            layer_ref: self.target_layer,
+            border: if self.target_layer.is_some() {
+                BorderStyle::Solid
+            } else {
+                BorderStyle::None
+            },
+            ..Default::default()
+        }
+    }
+}
+
+impl LabelProfile {
+    pub fn load_for(
+        definition: &KeyboardDefinition,
+        vial_uid: Option<[u8; 8]>,
+        layer_count: usize,
+    ) -> Option<Self> {
+        let path = ProjectDirs::from("dev", "srwi", "KeyPeek")?
+            .config_dir()
+            .join("labels.json");
+        let text = match std::fs::read_to_string(&path) {
+            Ok(text) => text,
+            Err(error) if error.kind() == ErrorKind::NotFound => return None,
+            Err(error) => {
+                eprintln!("Could not read label profile {}: {error}", path.display());
+                return None;
+            }
+        };
+        match Self::parse(&text) {
+            Ok(profile) => profile
+                .matches(definition, vial_uid, layer_count)
+                .then_some(profile),
+            Err(error) => {
+                eprintln!("Invalid label profile {}: {error}", path.display());
+                None
+            }
+        }
+    }
+
+    fn parse(text: &str) -> Result<Self, String> {
+        let profile: Self = serde_json::from_str(text).map_err(|e| e.to_string())?;
+        let layer_count = profile.layers.len();
+        if profile.rows == 0
+            || profile.cols == 0
+            || !(1..=32).contains(&layer_count)
+            || profile.layers.iter().any(|name| name.trim().is_empty())
+            || profile
+                .keycodes
+                .values()
+                .any(|label| !label.validate(layer_count))
+            || profile.positions.iter().any(|position| {
+                position.row >= profile.rows
+                    || position.col >= profile.cols
+                    || position.layer.is_some_and(|layer| layer >= layer_count)
+                    || !position.label.validate(layer_count)
+            })
+        {
+            return Err("Labels must have names and valid matrix/layer coordinates".into());
+        }
+        Ok(profile)
+    }
+
+    fn matches(
+        &self,
+        definition: &KeyboardDefinition,
+        vial_uid: Option<[u8; 8]>,
+        layer_count: usize,
+    ) -> bool {
+        definition.vid == self.vid
+            && definition.pid == self.pid
+            && vial_uid == Some(self.vial_uid)
+            && definition.rows == self.rows
+            && definition.cols == self.cols
+            && layer_count == self.layers.len()
+    }
+
+    pub fn layer_infos(&self, mut layers: Vec<LayerInfo>) -> Vec<LayerInfo> {
+        for (layer, name) in layers.iter_mut().zip(&self.layers) {
+            layer.name = Some(name.clone());
+        }
+        layers
+    }
+
+    pub fn display_key(
+        &self,
+        layer: usize,
+        row: usize,
+        col: usize,
+        action: Option<&KeyAction>,
+        original: Option<LayoutKey>,
+    ) -> Option<LayoutKey> {
+        let Some(KeyAction::Qmk(code)) = action else {
+            return original;
+        };
+        let label = self
+            .positions
+            .iter()
+            .find(|position| {
+                position.row == row
+                    && position.col == col
+                    && position.layer.is_none_or(|index| index == layer)
+            })
+            .map(|position| &position.label)
+            .or_else(|| self.keycodes.get(code));
+        label.map(DisplayLabel::layout_key).or(original)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::key_action::KeymapSnapshot;
+    use crate::key_matrix::KeyMatrix;
+
+    const PROFILE: &str = include_str!("../resources/corne-command-labels.json");
+
+    fn definition() -> KeyboardDefinition {
+        KeyboardDefinition {
+            vid: 0x4653,
+            pid: 0x0004,
+            rows: 8,
+            cols: 7,
+            layouts: vec![],
+        }
+    }
+
+    #[test]
+    fn labels_require_the_matching_device_uid_and_keymap_shape() {
+        let profile = LabelProfile::parse(PROFILE).unwrap();
+        let definition = definition();
+        let uid = Some([0x89, 0x36, 0x2a, 0xc7, 0xfa, 0xd8, 0x89, 0x45]);
+        assert!(profile.matches(&definition, uid, 16));
+        assert!(!profile.matches(&definition, None, 16));
+        assert!(!profile.matches(&definition, Some([0; 8]), 16));
+        assert!(!profile.matches(&definition, uid, 6));
+        assert!(!profile.matches(
+            &KeyboardDefinition {
+                pid: 5,
+                ..definition.clone()
+            },
+            uid,
+            16
+        ));
+        assert!(!profile.matches(
+            &KeyboardDefinition {
+                rows: 10,
+                ..definition
+            },
+            uid,
+            16
+        ));
+    }
+
+    #[test]
+    fn picker_and_control_labels_follow_the_custom_code() {
+        let profile = LabelProfile::parse(PROFILE).unwrap();
+        for (code, expected) in [
+            (0x7e00, "Home"),
+            (0x7e01, "Auto"),
+            (0x7e02, "Mirror"),
+            (0x7e0b, "OpenAI"),
+            (0x7e0d, "Browser"),
+        ] {
+            let action = KeyAction::Qmk(code);
+            let label = profile
+                .display_key(15, 1, 1, Some(&action), action.resolve_label(&[]))
+                .unwrap();
+            assert_eq!(label.tap.full, expected);
+        }
+        let moved = KeyAction::Qmk(0x0004);
+        let label = profile
+            .display_key(15, 1, 1, Some(&moved), moved.resolve_label(&[]))
+            .unwrap();
+        assert_eq!(label.tap.full, "A");
+    }
+
+    #[test]
+    fn menu_presentation_does_not_change_actions_or_transparency() {
+        let profile = LabelProfile::parse(PROFILE).unwrap();
+        let mut actions = vec![vec![vec![None; 7]; 8]; 16];
+        actions[15][3][3] = Some(KeyAction::Qmk(1));
+        let matrix = KeyMatrix::from_snapshot(
+            KeymapSnapshot {
+                layers: LayerInfo::indexed(16),
+                actions,
+            },
+            8,
+            7,
+        );
+        assert!(matrix.is_transparent(15, 3, 3));
+        let displayed = profile
+            .display_key(
+                15,
+                3,
+                3,
+                matrix.get_action(15, 3, 3),
+                matrix.get_key(15, 3, 3).cloned(),
+            )
+            .unwrap();
+        assert_eq!(displayed.tap.full, "Menu");
+        assert!(matrix.is_transparent(15, 3, 3));
+        assert_eq!(matrix.get_action(15, 3, 3), Some(&KeyAction::Qmk(1)));
+        assert!(profile.display_key(0, 3, 3, None, None).is_none());
+    }
+
+    #[test]
+    fn ordinary_home_row_mods_keep_their_hold_information() {
+        let profile = LabelProfile::parse(PROFILE).unwrap();
+        let action = KeyAction::Qmk(0x2804);
+        let original = action.resolve_label(&[]);
+        assert_eq!(
+            profile.display_key(7, 1, 1, Some(&action), original.clone()),
+            original
+        );
+    }
+
+    #[test]
+    fn layer_names_keep_firmware_ids_and_reject_invalid_profiles() {
+        let profile = LabelProfile::parse(PROFILE).unwrap();
+        let layers = profile.layer_infos(LayerInfo::indexed(16));
+        assert_eq!(layers[7].id, 7);
+        assert_eq!(layers[7].name.as_deref(), Some("OpenAI"));
+        assert_eq!(layers[9].name.as_deref(), Some("Browser"));
+        assert!(LabelProfile::parse(&PROFILE.replace("\"row\": 3", "\"row\": 8")).is_err());
+        assert!(LabelProfile::parse(
+            &PROFILE.replace("\"target_layer\": 15", "\"target_layer\": 16")
+        )
+        .is_err());
+    }
+}
